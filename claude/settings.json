{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(bundle exec erblint:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(bundle install:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(jj diff:*)",
      "Bash(jj log:*)",
      "Bash(jj pop)",
      "Bash(jj show:*)",
      "Bash(jj status)",
      "Bash(jj status:*)",
      "Bash(jj up)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(rg:*)",
      "Bash(rspec:*)",
      "Bash(rubocop -A)",
      "Bash(rubocop:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:github.com)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in /Users/luke/.claude/projects/-Users-luke-Code-stemma/memory/*) git -C /Users/luke/.claude/projects/-Users-luke-Code-stemma/memory add -A; git -C /Users/luke/.claude/projects/-Users-luke-Code-stemma/memory -c user.email=luke@therandalls.io -c \"user.name=Luke Randall\" commit -m \"Auto-sync: $(basename \"$f\")\" && git -C /Users/luke/.claude/projects/-Users-luke-Code-stemma/memory push -q origin main;; esac; } 2>/dev/null || true",
            "async": true,
            "timeout": 60,
            "statusMessage": "Syncing memory to stemma-evidence"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "subagentPromptCacheTtl": "1h",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
